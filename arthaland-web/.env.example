# Public Supabase project URL (safe for browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon key ONLY — never service role or secret keys
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. When unset (default): use Supabase for public CMS when URL + anon key are set.
# Set to local, false, or 0 to use bundled seed data instead (offline / demos only).
# VITE_CMS_SOURCE=local

# Optional: absolute URLs for Open Graph (e.g. https://arthaland-xi.vercel.app)
VITE_SITE_URL=
