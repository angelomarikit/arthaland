# Public Supabase project URL (safe for browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon key ONLY — never service role or secret keys
VITE_SUPABASE_ANON_KEY=your-anon-key

# When true, public property routes read published data from Supabase (fallback to local seed)
VITE_CMS_SOURCE=supabase

# Optional: absolute URLs for Open Graph (e.g. https://arthaland-xi.vercel.app)
VITE_SITE_URL=
